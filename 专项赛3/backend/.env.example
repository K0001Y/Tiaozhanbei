# 后端环境变量配置
# 数据库配置
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=medical_assistant

# JWT 配置
JWT_SECRET=your-super-secret-jwt-key-here-should-be-very-long-and-random
JWT_EXPIRES_IN=24h

# 服务器配置
PORT=5001
NODE_ENV=development

# AI模型服务配置
AI_CHATBOT_URL=http://localhost:8080
AI_CHATBOT_TIMEOUT=30000

# CORS 配置
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
